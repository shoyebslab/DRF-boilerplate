# Django Settings
SECRET_KEY=change-this-secret-key-in-production-random-64-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=starline_hospital_db
