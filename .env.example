DB_HOST=localhost
DB_PORT=5432

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Simple JWT Configuration
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
